# Public site URL — canonical links, OpenGraph, sitemap.
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Optional asset paths (files live under /public).
# Buttons/images render only when the file actually exists.
NEXT_PUBLIC_RESUME_PATH=/resume.pdf
NEXT_PUBLIC_PORTRAIT_PATH=/portrait.jpg

# --- AI assistant -----------------------------------------------------------
# Server-side only. NEVER prefix this with NEXT_PUBLIC_ — that would ship the
# key to the browser. Without it the assistant answers from portfolio data
# using deterministic retrieval instead of the model.
ANTHROPIC_API_KEY=
# Optional model override (default: claude-opus-5).
ANTHROPIC_MODEL=claude-opus-5

# --- Contact form -----------------------------------------------------------
# Optional. If set, /api/contact forwards submissions to this webhook
# (Slack, n8n, Zapier, Make, or your own endpoint).
CONTACT_WEBHOOK_URL=
